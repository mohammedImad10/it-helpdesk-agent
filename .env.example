# OpenRouter is required in deployed mode for the Intake & Safety and Resolution & Escalation roles.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL=openai/gpt-4.1-mini
EMBEDDING_MODEL=openai/text-embedding-3-small

# Simulated Helpdesk system, started by Docker Compose.
HELPDESK_API_URL=http://localhost:8102
HELPDESK_API_KEY=dev-key-change-me
HELPDESK_TIMEOUT_S=20
APP_URL=http://localhost:8000
